class Solution {
    public int search(int[] nums, int target) {
        int low = 0;
        int high = nums.length-1;
        while(low<=high)
        {
            int mid = (low+high)/2;
            if(nums[mid]==target) return mid;
            if(nums[low]<=nums[mid]) // if left part of mid is sorted
            {
                if(nums[low]<=target && target<nums[mid]) // if target lies in left part
                {
                    high = mid - 1;
                }
                else
                {
                    low= mid + 1; // if target lies in right part
                }
            }
            else if(nums[mid]<nums[high]) //if right part of mid is sorted 
            {
                if(nums[mid]<target && target<=nums[high])
                {
                    low = mid + 1;
                }
                else
                {
                    high = mid - 1;                                  
                }
            }
        }
        return -1;
    }
}
