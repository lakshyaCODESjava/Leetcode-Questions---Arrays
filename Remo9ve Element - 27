class Solution {
    public int removeElement(int[] nums, int val) {
        int i=0;
        int len = nums.length;
        int count = 0;
        for(int x=0;x<len;x++)
        {
            if(nums[x]!=val)
            {
                nums[i++] = nums[x];
                count++;
            }
        }
        return count;
    }
}
